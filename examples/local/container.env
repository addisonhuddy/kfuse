# Values for a container attached to the private kfuse-local Docker network.
# The demo container joins it via run.sh --local. Host ports are loopback-only,
# so host.docker.internal no longer works.
BOOTSTRAP_SERVER=kafka:9094
KAFKA_TLS=false
KAFKA_TOPIC=kfuse.events
KAFKA_PARTITIONS=8

S3_ENDPOINT=http://minio:9000
S3_PATH_STYLE=true
S3_REGION=us-east-1
S3_ACCESS_KEY=kfuse
S3_SECRET_KEY=kfuse-local-secret
S3_BUCKET=kfuse-local
S3_PREFIX=kfuse/local/
