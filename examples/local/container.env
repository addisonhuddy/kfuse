# Values for a Docker client on the default bridge network. The broker's
# second listener advertises host.docker.internal:9094; local.env uses the
# direct host listener instead.
BOOTSTRAP_SERVER=host.docker.internal:9094
KAFKA_TLS=false
KAFKA_TOPIC=kfuse.events
KAFKA_PARTITIONS=8

S3_ENDPOINT=http://host.docker.internal:9000
S3_PATH_STYLE=true
S3_REGION=us-east-1
S3_ACCESS_KEY=kfuse
S3_SECRET_KEY=kfuse-local-secret
S3_BUCKET=kfuse-local
S3_PREFIX=kfuse/local/
