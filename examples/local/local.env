# Local, credential-free kfuse stack values. Safe to commit: these are dummy
# credentials used only by the local MinIO container.
BOOTSTRAP_SERVER=127.0.0.1:9092
KAFKA_TLS=false
KAFKA_TOPIC=kfuse.events
KAFKA_PARTITIONS=8

S3_ENDPOINT=http://127.0.0.1:9000
S3_PATH_STYLE=true
S3_REGION=us-east-1
S3_ACCESS_KEY=kfuse
S3_SECRET_KEY=kfuse-local-secret
S3_BUCKET=kfuse-local
S3_PREFIX=kfuse/local/
