# kfuse configuration template.
# Copy to .env and fill in real values. NEVER commit .env.
# For Confluent Cloud, the Kafka credentials are a cluster-level Kafka API key
# (Cluster → API keys), NOT a Global/org key (SASL fails with [58]).

# --- Kafka ---
BOOTSTRAP_SERVER=pkc-YOUR_CLUSTER.us-west-2.aws.confluent.cloud:9092
# KAFKA_TLS defaults to true; set to false for the local development stack.
KAFKA_TLS=true
# Leave SASL unset for an unauthenticated local broker.
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_TOPIC=kfuse.events

# --- S3-compatible object storage ---
S3_REGION=us-west-2
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=kfuse-demo
S3_PREFIX=kfuse/
# Optional for MinIO or another S3-compatible endpoint:
# S3_ENDPOINT=http://localhost:9000
# S3_PATH_STYLE=true

# --- E2B example only ---
# E2B_KEY=

# --- Session / lower identity ---
KF_LOWER_ID=dev-lower

# --- Local state (optional) ---
# KF_STATE_DIR=/.kfuse
