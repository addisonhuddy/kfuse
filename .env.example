# kfuse configuration template.
# Copy to .env and fill in real values. NEVER commit .env.
# Examples also accept short-name aliases for the canonical Kafka, AWS, and bucket variables.
# BOOTSTRAP_SERVER, CONFLUENT_CLOUD_KEY, CONFLUENT_CLOUD_SECRET, REGION, AWS_ACCESS_KEY, AWS_SECRET_KEY, BUCKET
# The Kafka key is a Confluent Cloud *Kafka API key* (Cluster → API keys),
# NOT a Global/org key (SASL will fail with [58]).

# --- Kafka (Confluent Cloud, SASL_SSL) ---
KF_KAFKA_BROKERS=pkc-<cluster>.us-west-2.aws.confluent.cloud:9092
KF_KAFKA_SASL_USERNAME=
KF_KAFKA_SASL_PASSWORD=
KF_KAFKA_TLS=true
KF_KAFKA_TOPIC=kfuse.events
KF_KAFKA_PARTITIONS=8

# --- S3 (AWS) ---
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
KF_BLOB_BUCKET=kfuse-demo
KF_BLOB_PREFIX=kfuse/

# --- Session / lower identity ---
KF_LOWER_ID=dev-lower

# --- Local state (optional) ---
# KF_STATE_DIR=/.kfuse
